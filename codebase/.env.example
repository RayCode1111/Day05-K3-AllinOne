# Gemini API: giữ key thật trong .env, tuyệt đối không commit.
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Hạn mức free-tier là 20 request/model/ngày. Nova thử lần lượt các model dưới
# đây, hết quota model này thì tự chuyển sang model kế tiếp.
GEMINI_MODELS=gemini-3.6-flash,gemini-3.5-flash,gemini-2.5-flash,gemini-flash-latest,gemini-2.5-flash-lite
# Tăng nếu phản hồi bị cắt khi số thông báo Discord nhiều lên.
GEMINI_MAX_OUTPUT_TOKENS=16384

# Chế độ app
APP_ENV=development
APP_DATA_MODE=live

# Học viên dùng để tra trạng thái nộp bài trên Codelabs (API giả lập).
CODELABS_STUDENT_ID=K3-00123

# Tuỳ chọn: cổng mặc định của Streamlit được cấu hình trong .streamlit/config.toml
# STREAMLIT_SERVER_PORT=8501
