# Copy file này thành .env rồi điền. KHÔNG commit .env.
# Lấy key miễn phí tại https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_api_key
# Model dùng cho quyết định trung tâm (Google AI Studio free tier)
GEMINI_MODEL=gemini-3.0

# Trỏ về data pack được cấp — data pack KHÔNG nằm trong repo này (luật bảo mật)
VLEARN_DATA_DIR=../Day05-K3-AllinOne/data/vlearn-pack
